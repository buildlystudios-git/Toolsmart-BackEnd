{
  "family": "nestjs-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "nestjs-app",
      "image": "123456789012.dkr.ecr.ap-south-1.amazonaws.com/nestjs-app:{IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000
        }
      ]
    }
  ]
}