PORT=4000

# MongoDB - Use Docker service name (mongodb) for Docker environments
# For local development, override in .env.local with: mongodb://localhost:27017/toolzkart
MONGO_URI=mongodb://mongodb:27017/toolzkart


JWT_SECRET=toolzkart_secret
JWT_ISSUER=toolzkart-api
JWT_AUDIENCE=toolzkart-users

CB_SMS=true
SMS_PROVIDER=TWILIO

# TWILIO CONFIGURATION
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

MSG91_AUTH_KEY=your_key
MSG91_FLOW_ID=your_flow_id
MSG91_SENDER_ID=TOOLZK

# GUPSHUP CONFIGURATION
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_PHONE_NUMBER=your_whatsapp_number

# CORS
ALLOW_ORIGIN=http://localhost:3000,http://localhost:4000

# AWS
