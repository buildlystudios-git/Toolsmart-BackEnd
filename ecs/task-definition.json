{
  "family": "toolsmart-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::931932531235:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "toolsmart-backend",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4000"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "AWS_BUCKET",
          "value": "toolsmart"
        },
        {
          "name": "SMS_PROVIDER",
          "value": "TWILIO"
        },
        {
          "name": "CB_SMS",
          "value": "true"
        },
        {
          "name": "ALLOW_ORIGIN",
          "value": "http://localhost:3000,http://localhost:4000"
        }
      ],
      "secrets": [
        {
          "name": "AWS_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:AWS_ACCESS_KEY::"
        },
        {
          "name": "AWS_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:AWS_SECRET_KEY::"
        },
        {
          "name": "FIREBASE_PROJECT_ID",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:FIREBASE_PROJECT_ID::"
        },
        {
          "name": "FIREBASE_CLIENT_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:FIREBASE_CLIENT_EMAIL::"
        },
        {
          "name": "FIREBASE_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:FIREBASE_PRIVATE_KEY::"
        },  
        {
          "name": "MONGO_URI",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:MONGO_URI::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:JWT_SECRET::"
        },
        {
          "name": "JWT_ISSUER",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:JWT_ISSUER::"
        },
        {
          "name": "JWT_AUDIENCE",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:JWT_AUDIENCE::"
        },
        {
          "name": "TWILIO_ACCOUNT_SID",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:TWILIO_ACCOUNT_SID::"
        },
        {
          "name": "TWILIO_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:TWILIO_AUTH_TOKEN::"
        },
        {
          "name": "TWILIO_PHONE_NUMBER",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:931932531235:secret:toolsmart/backend:TWILIO_PHONE_NUMBER::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/toolsmart-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}